# API-Token: PFLICHT (fail-closed) — ohne diesen Wert startet der Server nicht.
# Schützt alle sensiblen Routen (/mcp, /api/*, /export, /import). Öffentlich
# bleiben nur /health und die Onboarding-Routen (/setup, /hooks/*, /cmd*);
# Loopback-Requests (lokale Web-UI / SSH-Tunnel) sind ohne Token erlaubt.
# Quelle der Wahrheit: mykeyvault (Item "ai-rem-api-token"). deploy.sh zieht den
# Token von dort und schreibt ihn in diese .env. Manuell erzeugen: openssl rand -hex 32
AI_REM_API_TOKEN=

# Öffentliche URL des Servers (wird im Setup-Script und Web UI angezeigt)
KG_PUBLIC_URL=http://<SERVER_IP>:3456

# TCP-Port (Standard: 3456)
PORT=3456

# Host-Pfad zur Datenbank (wird nach /data gemountet)
KG_DATA_PATH=./data

# Host-Pfad für Backup-Dateien (wird nach /backups gemountet)
KG_BACKUP_PATH=./backups

# Maximale Anzahl aufbewahrter Backups
MAX_BACKUPS=10

# Optional: Backup-Verschlüsselung (AES-256-GCM). Gesetzt → Backups werden
# verschlüsselt geschrieben (backup_<ts>.json.enc) und beim Download als
# verschlüsselter Blob ausgegeben; leer → Klartext wie bisher. Restore erkennt
# beide Formate automatisch. Quelle der Wahrheit: mykeyvault (Item
# "ai-rem-backup-key"). Passphrase erzeugen: openssl rand -hex 32
# ACHTUNG: Geht die Passphrase verloren, sind verschlüsselte Backups nicht
# mehr wiederherstellbar.
AI_REM_BACKUP_KEY=

# Anzahl paralleler Kuzu-DB-Verbindungen (Pool-Größe). Höher = mehr Parallelität
# bei gleichzeitigen Requests, mehr RAM. Default 4 reicht für Heim-Workloads.
KUZU_POOL_SIZE=4

# ── Embeddings (semantische Suche) ────────────────────────────────────────────
# Leer = in-process (fastembed/MiniLM, im Image :latest enthalten, kein externer
# Dienst nötig). Gesetzt = OpenAI-kompatibler Endpoint, dann kann das ~250 MB
# kleinere Image :latest-slim genutzt werden (bringt fastembed nicht mit).
# Beispiel: http://myai:11435/v1/embeddings
# Ein Wechsel des Backends rechnet beim nächsten Start alle Vektoren neu (andere
# Dimension). Ist der Endpoint nicht erreichbar, werden Einträge ohne Vektor
# gespeichert und die Suche läuft rein lexikalisch weiter — der Backfill holt die
# fehlenden Vektoren nach, sobald der Dienst wieder da ist.
EMBED_URL=

# Modellname für den externen Endpoint (nur relevant, wenn EMBED_URL gesetzt ist)
EMBED_HTTP_MODEL=bge-m3

# Text wird vor dem Embedden auf diese Länge gekappt. fastembed kürzt zu lange
# Eingaben still an der Modellgrenze, llama.cpp antwortet stattdessen mit HTTP 500
# und riss damit den ganzen Backfill-Chunk mit. 2000 Zeichen liegen sicher unter
# der 1024-Token-Grenze und über dem, was das in-process-Modell je verarbeitet hat.
EMBED_MAX_CHARS=2000

# Image-Tag: latest (mit in-process Embeddings) oder latest-slim (braucht EMBED_URL)
AI_REM_TAG=latest

# Speicherlimit des Containers. Ohne Embedding-Modell (slim + EMBED_URL) reichen 512m.
MEM_LIMIT=1536m
